From e8a08744a1b27a524d069bc65c4f066625e5df12 Mon Sep 17 00:00:00 2001
From: Cuong-Tran <16017808+cuong-tran@users.noreply.github.com>
Date: Sat, 28 Nov 2026 14:14:52 +0700
Subject: [PATCH] fix(mdlist): Look up a missing MangaDex source again instead
 of until a restart

MdList cached MdUtil.getEnabledMangaDex() with by lazy, null included.
Sources load asynchronously, so a first use before MangaDex was loaded,
or before it was installed or enabled, left MDList refresh, search and
metadata failing with "Mangadex not enabled" until the app restarted.
A null is no longer cached; a found source still is.
---
 .../tachiyomi/data/track/mdlist/MdList.kt     |  9 ++++-
 .../tachiyomi/data/track/mdlist/MdListTest.kt | 37 +++++++++++++++++++
 2 files changed, 45 insertions(+), 1 deletion(-)

diff --git a/app/src/main/java/eu/kanade/tachiyomi/data/track/mdlist/MdList.kt b/app/src/main/java/eu/kanade/tachiyomi/data/track/mdlist/MdList.kt
index 2c48d84004..bc2ec0e9f2 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/data/track/mdlist/MdList.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/data/track/mdlist/MdList.kt
@@ -29,7 +29,14 @@ class MdList(id: Long) : BaseTracker(id, "MDList") {
             .toImmutableList()
     }
 
-    private val mdex by lazy { MdUtil.getEnabledMangaDex() }
+    // KMK -->
+    // Cached like `by lazy` once found, but a `null` is not cached: sources still loading (the desktop loads them
+    // asynchronously) or MangaDex installed / enabled later kept MDList unusable until a restart
+    @Volatile
+    private var cachedMdex: eu.kanade.tachiyomi.source.online.all.MangaDex? = null
+    private val mdex: eu.kanade.tachiyomi.source.online.all.MangaDex?
+        get() = cachedMdex ?: MdUtil.getEnabledMangaDex()?.also { cachedMdex = it }
+    // KMK <--
 
     // KMK -->
     val sessionNotifier = MangaDexSessionNotifier()
diff --git a/app/src/test/java/eu/kanade/tachiyomi/data/track/mdlist/MdListTest.kt b/app/src/test/java/eu/kanade/tachiyomi/data/track/mdlist/MdListTest.kt
index ca17e7f584..e1cc9f2679 100644
--- a/app/src/test/java/eu/kanade/tachiyomi/data/track/mdlist/MdListTest.kt
+++ b/app/src/test/java/eu/kanade/tachiyomi/data/track/mdlist/MdListTest.kt
@@ -1,18 +1,28 @@
