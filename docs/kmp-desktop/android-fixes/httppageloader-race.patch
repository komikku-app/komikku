From c8a410701bbb522e86c566a3e2eeccbfd8c9ad02 Mon Sep 17 00:00:00 2001
From: Cuong-Tran <16017808+cuong-tran@users.noreply.github.com>
Date: Sat, 28 Nov 2026 17:02:35 +0700
Subject: [PATCH] fix(reader): Load an online page on one thread at a time so
 it is never ready before its image is cached

HttpPageLoader's reader threads share one queue that holds a page once per
loadPage call. Two threads that took the page before either marked it as
downloading both downloaded it; the chapter cache's editor went to the
first, the second wrote nothing and still set the page Ready, so the
viewer failed to decode it and never retried. A thread now skips a page
another thread is loading, and loads it only while it is still queued.

HttpPageLoaderTest failed before the fix (Ready with the image not in the
cache) and passes after it. The race was first seen in the desktop reader,
which runs this file: a reader UI test failed on it once in CI, and with
the fix the reader tests passed 15 of 15 runs under load.
---
 .../ui/reader/loader/HttpPageLoader.kt        |  22 +++-
 .../ui/reader/loader/HttpPageLoaderTest.kt    | 106 ++++++++++++++++++
 2 files changed, 127 insertions(+), 1 deletion(-)
 create mode 100644 app/src/test/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoaderTest.kt

diff --git a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoader.kt b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoader.kt
index e3adc33b92..aa6af789a6 100644
--- a/app/src/main/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoader.kt
+++ b/app/src/main/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoader.kt
@@ -25,6 +25,7 @@ import tachiyomi.core.common.util.lang.launchIO
 import tachiyomi.core.common.util.lang.withIOContext
 import uy.kohesive.injekt.Injekt
 import uy.kohesive.injekt.api.get
+import java.util.concurrent.ConcurrentHashMap
 import java.util.concurrent.PriorityBlockingQueue
 import kotlin.concurrent.atomics.AtomicInt
 import kotlin.concurrent.atomics.ExperimentalAtomicApi
@@ -52,6 +53,15 @@ internal class HttpPageLoader(
      */
     private val queue = PriorityBlockingQueue<PriorityPage>()
 
+    // KMK -->
+    /**
+     * The pages a reader thread is loading now. A page can be in the [queue] more than once; a second thread that took
+     * it before the first one marked it as downloading would download it too, find the cache's editor taken and mark
+     * the page ready before its image is in the cache.
+     */
+    private val loadingPages = ConcurrentHashMap.newKeySet<ReaderPage>()
+    // KMK <--
+
     private val preloadSize = /* SY --> */ readerPreferences.preloadSize().get() // SY <--
 
     // SY -->
@@ -69,7 +79,17 @@ internal class HttpPageLoader(
                     }
                 }
                     .filter { it.status == Page.State.Queue }
-                    .collect(::internalLoadPage)
+                    // KMK -->
+                    .collect { page ->
+                        if (!loadingPages.add(page)) return@collect
+                        try {
+                            // Another thread may have loaded it between the filter and the add
+                            if (page.status == Page.State.Queue) internalLoadPage(page)
+                        } finally {
+                            loadingPages.remove(page)
+                        }
+                    }
+                // KMK <--
             }
             // EXH -->
         }
diff --git a/app/src/test/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoaderTest.kt b/app/src/test/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoaderTest.kt
new file mode 100644
index 0000000000..20edff27da
--- /dev/null
+++ b/app/src/test/java/eu/kanade/tachiyomi/ui/reader/loader/HttpPageLoaderTest.kt
@@ -0,0 +1,106 @@
+package eu.kanade.tachiyomi.ui.reader.loader
+
+import eu.kanade.domain.source.service.SourcePreferences
+import eu.kanade.tachiyomi.data.cache.ChapterCache
+import eu.kanade.tachiyomi.data.database.models.Chapter
+import eu.kanade.tachiyomi.source.model.Page
+import eu.kanade.tachiyomi.source.online.HttpSource
+import eu.kanade.tachiyomi.ui.reader.model.ReaderChapter
+import eu.kanade.tachiyomi.ui.reader.model.ReaderPage
+import eu.kanade.tachiyomi.ui.reader.setting.ReaderPreferences
+import io.kotest.matchers.shouldBe
+import io.mockk.coEvery
+import io.mockk.coVerify
+import io.mockk.every
+import io.mockk.mockk
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.jupiter.api.Test
+import tachiyomi.core.common.preference.InMemoryPreferenceStore
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+
+class HttpPageLoaderTest {
+
+    /**
+     * The loader runs two reader threads (`eh_reader_threads`) over one queue, and a page is in it once per
+     * [HttpPageLoader.loadPage] call (the viewer's preload and its shown page both call it). The chapter cache below
+     * behaves like the real one where it matters: one editor per key, so a second concurrent write returns without
+     * writing. Its cache lookup waits (at most a second) for a second caller, which keeps the first thread from marking
+     * the page as downloading before the second thread could take the page too.
+     */
+    @Test
+    fun `a page asked for twice at once is downloaded once and is ready only once its image is cached`(): Unit =
+        runBlocking {
+            val cached = AtomicBoolean(false)
+            val lookups = CountDownLatch(2)
+            val editorTaken = AtomicBoolean(false)
+            val chapterCache = mockk<ChapterCache> {
+                every { isImageInCache(IMAGE_URL) } answers {
+                    lookups.countDown()
+                    lookups.await(1, TimeUnit.SECONDS)
+                    cached.get()
+                }
+                every { putImageToCache(IMAGE_URL, any()) } answers {
+                    if (editorTaken.compareAndSet(false, true)) {
+                        Thread.sleep(300)
+                        cached.set(true)
+                    }
+                }
+                every { getImageFile(IMAGE_URL) } returns File("unused")
+            }
+            val source = mockk<HttpSource> {
+                coEvery { getImage(any()) } answers { imageResponse() }
+            }
+            val chapter = ReaderChapter(mockk<Chapter>(relaxed = true))
+            val loader = HttpPageLoader(
+                chapter = chapter,
+                source = source,
+                chapterCache = chapterCache,
+                readerPreferences = ReaderPreferences(InMemoryPreferenceStore()),
+                sourcePreferences = SourcePreferences(InMemoryPreferenceStore()),
+            )
+            val page = ReaderPage(0, "https://example.org/page/1", IMAGE_URL).also { it.chapter = chapter }
+            val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+            try {
+                val cachedAtFirstReady = scope.async {
+                    page.statusFlow.first { it == Page.State.Ready }
+                    cached.get()
+                }
+                repeat(2) { scope.launch { loader.loadPage(page) } }
+
+                withTimeout(10_000) { cachedAtFirstReady.await() } shouldBe true
+                // A second download, if one started, has ended by now
+                Thread.sleep(1_500)
+                coVerify(exactly = 1) { source.getImage(any()) }
+            } finally {
+                scope.cancel()
+                loader.recycle()
+            }
+        }
+
+    private fun imageResponse() = Response.Builder()
+        .request(Request.Builder().url(IMAGE_URL).build())
+        .protocol(Protocol.HTTP_1_1)
+        .code(200)
+        .message("OK")
+        .body(byteArrayOf(1, 2, 3).toResponseBody())
+        .build()
+
+    private companion object {
+        const val IMAGE_URL = "https://example.org/1.png"
+    }
+}

