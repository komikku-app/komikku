#version 450

#ifdef FUSED_FP16
#extension GL_EXT_shader_16bit_storage : require
#define storage_t float16_t
#else
#define storage_t float
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;
layout(std430, binding = 0) readonly buffer bottom_blob {
    float bottom_blob_data[];
};
layout(std430, binding = 1) writeonly buffer top_blob {
    storage_t top_blob_data[];
};

layout(push_constant) uniform parameter {
    int w;
    int h;
    int cstep;
    int outw;
    int outh;
    int outcstep;
    int pad_top;
    int pad_left;
    int crop_x;
    int crop_y;
    int channels;
    int alphaw;
    int alphah;
} p;

void main() {
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);
    if (gx >= p.outw || gy >= p.outh || gz >= p.channels) return;

    int x = clamp(gx + p.crop_x - p.pad_left, 0, p.w - 1);
    int y = clamp(gy + p.crop_y - p.pad_top, 0, p.h - 1);
    int source_channel = 2 - gz;
    uint packed_pixel = floatBitsToUint(bottom_blob_data[y * p.w + x]);
    float value = float((packed_pixel >> uint(source_channel * 8)) & 255u) / 255.0;
    top_blob_data[gz * p.outcstep + gy * p.outw + gx] = storage_t(value);
}
